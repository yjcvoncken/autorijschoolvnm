{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "python manage.py collectstatic --noinput"
  },
  "deploy": {
    "startCommand": "python manage.py migrate && gunicorn vnm.wsgi:application --bind 0.0.0.0:$PORT --access-logfile - --error-logfile -",
    "healthcheckPath": "/health/",
    "healthcheckTimeout": 120
  }
}
